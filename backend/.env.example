# Copie este arquivo para ".env" e preencha com os dados reais

# String de conexão do Postgres (Supabase, Neon, RDS, ou local)
DATABASE_URL=postgres://usuario:senha@localhost:5432/gestao_motel

# Chave secreta pra assinar os tokens de login — troque por algo aleatório e longo
JWT_SECRET=troque-esta-chave-por-algo-bem-aleatorio-e-secreto

# Porta em que o sistema vai rodar (serve a API e a tela, os dois juntos)
PORT=3001

# Normalmente pode deixar em * — front-end e back-end rodam na mesma origem
# (mesmo processo). Só precisa restringir isso se algum dia for exposto pra
# fora da rede local.
CORS_ORIGIN=*
